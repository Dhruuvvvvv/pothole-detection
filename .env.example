# ============================================================================
# RoadGuard AI — Environment Configuration Template
# Copy this file to `.env` for local overrides. Never commit real credentials.
# ============================================================================

# Application
APP_NAME="RoadGuard AI"
APP_ENV="development"
APP_HOST="127.0.0.1"
APP_PORT=8000
LOG_LEVEL="INFO"

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database (SQLite default; supports PostgreSQL e.g. postgresql+psycopg://user:pass@localhost:5432/roadguard)
DATABASE_URL="sqlite:///./outputs/roadguard.db"

# Model Configuration
MODEL_CHECKPOINT_PATH="./models/best.pt"
FALLBACK_ARCHITECTURE="yolo26n.pt"
DEFAULT_CONF_THRESHOLD=0.25
DEFAULT_IOU_THRESHOLD=0.45
DEFAULT_IMAGE_SIZE=640
INFERENCE_DEVICE="auto"

# Upload & Processing Limits
MAX_IMAGE_UPLOAD_MB=25
MAX_VIDEO_UPLOAD_MB=250
TEMP_RETENTION_HOURS=24

# Dataset Pipeline (Kaggle credentials read from ~/.kaggle/kaggle.json or KAGGLE_CONFIG_DIR)
KAGGLE_DATASET_SLUG="aliabdelmenam/rdd-2022"
DATASET_OUTPUT_DIR="./outputs/dataset"

# Damage Assessment Priority Heuristic Thresholds (0 - 100 scale)
PRIORITY_LOW_MAX=35.0
PRIORITY_HIGH_MIN=65.0
